<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ChiTietMonActivity">

    <TextView
        android:id="@+id/txttieude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chi tiết món"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgmon"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#F5F5F5"
        android:layout_marginTop="12dp"
        android:contentDescription="Ảnh món"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/txttenmon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tên món"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtdanhmuc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Danh mục" />

    <TextView
        android:id="@+id/txtgia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Giá"
        android:textColor="#D32F2F"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/txtmota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mô tả" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btngiam"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="−"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editsoluong"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:hint="SL"
            android:inputType="number"
            android:text="1"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btntang"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnthemgio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="THÊM VÀO GIỎ" />

    <Button
        android:id="@+id/btngiohang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="XEM GIỎ HÀNG" />

    <Button
        android:id="@+id/btnquaylai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="QUAY LẠI" />
</LinearLayout>