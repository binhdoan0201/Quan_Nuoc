<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F3"
    android:orientation="vertical"
    tools:context=".ChiTietMonActivity">

    <LinearLayout
        android:id="@+id/llheader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txttieude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chi tiết món"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imgmon"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Ảnh món"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/llthongtin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txttenmon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên món"
            android:textColor="#3E2C23"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtdanhmuc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Danh mục"
            android:textColor="#9A8B7E"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtgia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Giá"
            android:textColor="#FC6076"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtmota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mô tả"
            android:textColor="#6B5B50"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btngiam"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:backgroundTint="#FC6076"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:cornerRadius="22dp" />

        <EditText
            android:id="@+id/editsoluong"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:hint="SL"
            android:inputType="number"
            android:padding="0dp"
            android:text="1"
            android:textColor="#3E2C23"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btntang"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:backgroundTint="#FC6076"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:cornerRadius="22dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnthemgio"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#FC6076"
        android:text="THÊM VÀO GIỎ"
        android:textColor="#FFFFFF"
        app:cornerRadius="14dp" />

    <Button
        android:id="@+id/btngiohang"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#2EC4B6"
        android:text="XEM GIỎ HÀNG"
        android:textColor="#FFFFFF"
        app:cornerRadius="14dp" />

    <Button
        android:id="@+id/btnquaylai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#00000000"
        android:text="QUAY LẠI"
        android:textColor="#B0A096" />
</LinearLayout>