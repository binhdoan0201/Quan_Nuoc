<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F3"
    android:orientation="vertical"
    tools:context=".QuanLyMonActivity">

    <LinearLayout
        android:id="@+id/llheader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txttieude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ MÓN"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llform"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edittenmon"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="3"
                android:hint="Tên món"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editgia"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="2"
                android:hint="Giá (VNĐ)"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textSize="13sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/editmota"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:hint="Mô tả món"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtdanhmuc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Danh mục / Lọc:"
                android:textColor="#6B5B50"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spdanhmuc"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtanh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Ảnh món:"
                android:textColor="#6B5B50"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spanh"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/imgxemtruoc"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Xem trước ảnh"
                android:scaleType="centerCrop"
                android:src="@drawable/mon1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnthem"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:backgroundTint="#2EC4B6"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Thêm"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnsua"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:backgroundTint="#FF9A44"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Sửa"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnxoa"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:backgroundTint="#FC6076"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Xóa"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnlammoi"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:backgroundTint="#B0A096"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Làm mới"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/lvdanhsach"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:scrollbars="none" />

    <Button
        android:id="@+id/btnquaylai"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:backgroundTint="#EFE6DC"
        android:text="QUAY LẠI"
        android:textColor="#6B5B50"
        app:cornerRadius="14dp" />
</LinearLayout>